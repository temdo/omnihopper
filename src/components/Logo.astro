---
// OmniHopper mark: the letter H set symmetrically in a rounded rectangle,
// drawn as one closed outline on a 22 x 26 grid (legs 8, slot 6, notches 8,
// corner radius 8). Colour follows currentColor.
interface Props { size?: number; class?: string }
const { size = 26, class: cls } = Astro.props;
---
<svg class={cls} width={Math.round((size * 22) / 26)} height={size} viewBox="0 0 22 26" aria-hidden="true">
  <path fill="currentColor" d="M0 8A8 8 0 0 1 8 0V8H14V0A8 8 0 0 1 22 8V18A8 8 0 0 1 14 26V18H8V26A8 8 0 0 1 0 18Z" />
</svg>
