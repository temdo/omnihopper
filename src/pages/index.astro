---
import '../styles/global.css';
import Wire from '../components/Wire.astro';
import Logo from '../components/Logo.astro';
import Lines from '../components/Lines.astro';
import { sectors, allMissions } from '../lib/missions';

const first = allMissions.find((m) => m.id === 'isr')!;

const particulars: [string, string, string][] = [
  ['A', 'Length overall', '8,323 mm'],
  ['B', 'Beam', '2,250 mm'],
  ['C', 'Freeboard', '441 mm'],
  ['D', 'Draft', '0.33 m'],
  ['E', 'Moulded depth', '771 mm'],
  ['', 'Empty weight', '700 kg'],
  ['', 'Maximum weight', '1,300 kg'],
  ['', 'Payload', '600 kg'],
  ['', 'Cruise speed', '35 kn (Beaufort 0)'],
  ['', 'Maximum speed', '60 kn'],
  ['', 'Range', '500 nm'],
  ['', 'Fuel', '1,200 l'],
  ['', 'Propulsion', 'Mercury Marine V6 outboard, 200 bhp / 149 kW, 5,800 rpm max'],
  ['', 'Propeller', 'Mercury Enertia 14¾ × 19 in'],
  ['', 'Towed payload', '6.8 kg, 254 × 366 mm, anchored at the bow'],
];

const record = [
  {
    phase: 'Adaptation',
    lead: 'Rapid retrofitting and structural optimisation of the hull for a specific mission profile.',
    work: [
      ['Sensor integration', 'EO/IR, SIGINT, active and passive sonar arrays'],
      ['Antenna masts', 'Structural modification for high-gain, EW-resilient communications'],
      ['Power management', 'Energy systems for long-endurance autonomous and semi-autonomous operation'],
    ],
  },
  {
    phase: 'Sea trials',
    lead: 'The ocean is the ultimate validator. We move systems from the lab to Sea State 4 and beyond.',
    work: [
      ['Rapid prototyping', 'Raising technology readiness level through iterative on-water testing'],
      ['Stress testing', 'Hull integrity and electronic resilience under extreme maritime conditions'],
      ['UxV deployment', 'Launch and recovery support for unmanned surface and underwater vehicles'],
    ],
  },
  {
    phase: 'Sustainment',
    lead: 'Operational uptime is non-negotiable. Maintenance, repair and overhaul built for specialised fleets.',
    work: [
      ['Predictive maintenance', 'Platform data used to keep the vessel available'],
      ['Remote field support', 'Technical teams that deploy to remote operating areas'],
      ['Lifecycle management', 'From commissioning to decommissioning'],
    ],
  },
];

const standards: [string, string][] = [
  ['Engineering', 'IEEE 12207, ISO 9001'],
  ['Maritime', 'SOLAS, IMO standards and relevant NATO STANAGs for maritime data exchange'],
  ['Cyber-physical security', 'ISO/IEC 27001-aligned handling of data from integrated sensors'],
];

const inquiryTypes = ['Platform specifications', 'Sea trial availability', 'Fleet sustainment & MRO', 'Technical consultation', 'Other'];

const figures: [string, string, string][] = [
  ['8.3', 'm', 'Length overall'],
  ['0.33', 'm', 'Draft, for shallow coastal water'],
  ['1,200', 'l', 'Fuel aboard'],
  ['10', '', 'Mission fits on one hull'],
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>OmniHopper — High-endurance autonomous surface vessel</title>
  <meta name="description" content="OmniHopper is a high-endurance autonomous surface vessel for defence, security and offshore missions: 500 nm range, 600 kg payload, 60 kn, with adaptation, sea trials and sustainment from one supplier." />
  <meta name="theme-color" content="#0a0b0c" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>

  <header class="mast">
    <div class="wrap mast-in">
      <a class="brand" href="#top" aria-label="OmniHopper, top of page"><Logo size={26} /> <span>OmniHopper</span></a>
      <nav aria-label="Sections">
        <a href="#missions">Missions</a>
        <a href="#particulars">Particulars</a>
        <a href="#lifecycle">Lifecycle</a>
        <a href="#standards">Standards</a>
      </nav>
      <a class="btn btn-sm" href="#enquiries">Request briefing</a>
    </div>
  </header>

  <main id="main">
    <section class="hero" id="top" aria-labelledby="title">
      <div class="hero-stage" aria-hidden="false">
        <div class="hero-model">
          <Wire id="hero-wire" hotspots label="OmniHopper autonomous catamaran drawn as a wireframe from off the starboard bow: two hulls under one bridge deck, a compact electronics housing aft with an EO/IR gimbal on its roof, open mission deck forward, one outboard engine on the transom between the hulls." />
        </div>
      </div>
      <div class="wrap hero-in">
        <div class="hero-copy">
          <p class="kick">Autonomous surface vessel</p>
          <h1 id="title"><span class="nw">High-endurance</span> maritime platform for <span class="nw">mission-critical</span> operations</h1>
          <p class="dek">One unmanned platform for patrol, defence, rescue and logistics. No crew aboard, and the whole service life supported by one team.</p>
          <div class="hero-act">
            <a class="btn" href="#enquiries">Request technical documentation</a>
            <a class="btn btn-ghost" href="#missions">Ten mission fits</a>
          </div>
        </div>
        <dl class="stats" aria-label="Key figures">
          <div><dt>Maximum speed</dt><dd>60<small> kn</small></dd></div>
          <div><dt>Range</dt><dd>500<small> nm</small></dd></div>
          <div class="key"><dt>Payload</dt><dd>600<small> kg</small></dd></div>
        </dl>
      </div>
    </section>

    <section class="missions" id="missions" aria-labelledby="missions-h">
      <div class="wrap">
        <div class="sec-head">
          <p class="kick">01 Missions</p>
          <h2 id="missions-h">One platform.<br /><span class="indent">Ten mission fits.</span></h2>
        </div>
        <div class="stage">
          <div class="picker" role="radiogroup" aria-label="Mission">
            {sectors.map((s) => (
              <fieldset>
                <legend class="kick">{s.name}</legend>
                <div class="chips">
                  {s.missions.map((m) => (
                    <button type="button" role="radio" class="chip" aria-checked={m.id === first.id ? 'true' : 'false'} data-mission={m.id}>{m.name}</button>
                  ))}
                </div>
              </fieldset>
            ))}
          </div>
          <div class="stage-model">
            <p class="backdrop stage-word" aria-hidden="true">{first.word}</p>
            <Wire id="mission-wire" fit="all" label="OmniHopper wireframe with the selected mission package highlighted." />
          </div>
          <div class="mission-entry" aria-live="polite">
            <p class="kick" data-f="sector">{first.sector}</p>
            <h3 data-f="name">{first.name}</h3>
            <p class="note" data-f="note">{first.note}</p>
            <dl>
              <div><dt>Package</dt><dd data-f="package">{first.package}</dd></div>
              <div><dt>Sensors</dt><dd data-f="sensors">{first.sensors}</dd></div>
              <div><dt>Effect</dt><dd data-f="effectors">{first.effectors}</dd></div>
            </dl>
          </div>
        </div>
      </div>
    </section>

    <section class="band" aria-labelledby="band-h">
      <div class="wrap band-in">
        <h2 id="band-h">A platform built<br /><span class="indent">to operate</span><br /><span class="indent-2">at sea</span></h2>
        <p class="band-copy">Operates without constant human oversight. Integrates with UAVs and other networked systems. Reinforced hull with maritime-grade protection.</p>
        <dl class="figs">
          {figures.map(([n, u, c], i) => (
            <div class:list={{ key: i === 3 }}><dd>{n}{u && <small> {u}</small>}</dd><dt>{c}</dt></div>
          ))}
        </dl>
      </div>
    </section>

    <section class="particulars" id="particulars" aria-labelledby="part-h">
      <div class="wrap">
        <div class="sec-head">
          <p class="kick">02 Particulars</p>
          <h2 id="part-h">Lines and principal figures</h2>
        </div>
        <div class="part-grid">
          <Lines />
        </div>
        <div class="specs">
          {[particulars.slice(0, 8), particulars.slice(8)].map((rows, i) => (
            <table class="spec">
              <caption class="kick">{i === 0 ? 'Dimensions and weights' : 'Performance and propulsion'}</caption>
              <tbody>
                {rows.map(([r, k, v]) => (
                  <tr data-ref={r || undefined}><th scope="row"><span class="ref">{r}</span>{k}</th><td>{v}</td></tr>
                ))}
              </tbody>
            </table>
          ))}
        </div>
      </div>
    </section>

    <section class="lifecycle" id="lifecycle" aria-labelledby="life-h">
      <div class="wrap">
        <div class="sec-head">
          <p class="kick">03 Lifecycle</p>
          <h2 id="life-h">Forged at sea.<br /><span class="indent">Built for resilience.</span></h2>
          <p class="sec-copy">Modern maritime security needs platforms that survive high-attrition, infrastructure-denied environments. We carry the vessel through its whole service life, so you do not assemble hull, integration, trials and support from separate vendors.</p>
        </div>
        <ol class="phases">
          {record.map((r, i) => (
            <li>
              <p class="idx">0{i + 1}</p>
              <h3>{r.phase}</h3>
              <p class="lead">{r.lead}</p>
              <dl>
                {r.work.map(([k, v]) => (<div><dt>{k}</dt><dd>{v}</dd></div>))}
              </dl>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="standards" id="standards" aria-labelledby="std-h">
      <div class="wrap std-in">
        <div class="panel">
          <p class="kick">04 Standards</p>
          <h2 id="std-h">Standards and interoperability</h2>
          <p>Our engineering processes follow international and maritime standards, so the vessel fits into existing defence and industrial architectures.</p>
        </div>
        <dl class="std-list">
          {standards.map(([k, v]) => (<div><dt>{k}</dt><dd>{v}</dd></div>))}
        </dl>
      </div>
    </section>

    <section class="enquiries" id="enquiries" aria-labelledby="enq-h">
      <div class="wrap enq-in">
        <div>
          <p class="kick">05 Enquiries</p>
          <h2 id="enq-h">Request technical documentation</h2>
          <p class="sec-copy">Secure your maritime perimeter with field-validated engineering. Tell us the mission and we will send the relevant specifications, configurations and sea-trial availability.</p>
        </div>
        <form class="form" method="post" action="/api/enquiry" novalidate>
          <label><span>Name</span><input name="name" autocomplete="name" required /></label>
          <label><span>Organisation</span><input name="organisation" autocomplete="organization" /></label>
          <label><span>Email</span><input name="email" type="email" autocomplete="email" required /></label>
          <label><span>Inquiry</span>
            <select name="type" required>
              <option value="">Select inquiry type</option>
              {inquiryTypes.map((t) => <option>{t}</option>)}
            </select>
          </label>
          <label class="full"><span>Message</span><textarea name="message" rows="5" required></textarea></label>
          <input type="text" name="company_site" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true" />
          <div class="full actions">
            <button class="btn" type="submit">Submit inquiry</button>
            <p class="status" role="status" aria-live="polite"></p>
          </div>
        </form>
      </div>
    </section>
  </main>

  <footer class="foot">
    <div class="wrap foot-in">
      <span class="brand"><Logo size={26} /> OmniHopper</span>
      <span>High-endurance maritime platforms</span>
      <span>© 2026</span>
    </div>
  </footer>

  <script>
    const data = JSON.parse(document.getElementById('missions-data')!.textContent!);
    const wire = document.getElementById('mission-wire')!;
    const word = document.querySelector<HTMLElement>('.stage-word')!;
    const buttons = [...document.querySelectorAll<HTMLButtonElement>('[data-mission]')];
    const fields = [...document.querySelectorAll<HTMLElement>('.mission-entry [data-f]')];

    function select(id: string, focus = false) {
      const m = data[id];
      wire.dataset.active = id;
      word.textContent = m.word;
      word.classList.remove('swap');
      void word.offsetWidth;
      word.classList.add('swap');
      buttons.forEach((b) => {
        const on = b.dataset.mission === id;
        b.setAttribute('aria-checked', String(on));
        b.tabIndex = on ? 0 : -1;
        if (on && focus) b.focus();
      });
      fields.forEach((el) => { el.textContent = m[el.dataset.f!]; });
    }
    buttons.forEach((b, i) => {
      b.tabIndex = b.getAttribute('aria-checked') === 'true' ? 0 : -1;
      b.addEventListener('click', () => select(b.dataset.mission!));
      b.addEventListener('keydown', (e) => {
        const d = e.key === 'ArrowRight' || e.key === 'ArrowDown' ? 1 : e.key === 'ArrowLeft' || e.key === 'ArrowUp' ? -1 : 0;
        if (!d) return;
        e.preventDefault();
        select(buttons[(i + d + buttons.length) % buttons.length].dataset.mission!, true);
      });
    });

    const mast = document.querySelector('.mast')!;
    const onScroll = () => mast.classList.toggle('solid', scrollY > 40);
    addEventListener('scroll', onScroll, { passive: true });
    onScroll();
    const form = document.querySelector<HTMLFormElement>('.form')!;
    const status = form.querySelector<HTMLElement>('.status')!;
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      form.querySelectorAll('[aria-invalid]').forEach((el) => el.removeAttribute('aria-invalid'));
      const bad = [...form.querySelectorAll<HTMLInputElement>('[required]')].filter((el) => !el.checkValidity());
      if (bad.length) {
        bad.forEach((el) => el.setAttribute('aria-invalid', 'true'));
        status.dataset.state = 'error';
        status.textContent = `Please complete: ${bad.map((el) => el.closest('label')!.querySelector('span')!.textContent).join(', ')}.`;
        bad[0].focus();
        return;
      }
      const btn = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
      btn.disabled = true;
      status.dataset.state = 'busy';
      status.textContent = 'Sending…';
      try {
        const res = await fetch(form.action, { method: 'POST', body: new FormData(form) });
        if (!res.ok) throw new Error(String(res.status));
        status.dataset.state = 'ok';
        status.textContent = 'Received. We will reply from our engineering desk within two working days.';
        form.reset();
      } catch {
        status.dataset.state = 'error';
        status.textContent = 'The inquiry did not go through. Check your connection and submit again.';
      } finally {
        btn.disabled = false;
      }
    });
  </script>
  <script type="application/json" id="missions-data" set:html={JSON.stringify(Object.fromEntries(allMissions.map((m) => [m.id, m])))} />
</body>
</html>

<style>
  .skip { position: absolute; left: -999px; top: 8px; background: var(--signal); color: var(--signal-ink); padding: 8px 12px; z-index: 10; border-radius: 999px; }
  .skip:focus { left: 8px; }

  .btn {
    display: inline-flex; align-items: center; justify-content: center; gap: var(--s2);
    min-height: 48px; padding: 0 28px;
    background: var(--signal); color: var(--signal-ink);
    font: 500 .8125rem/1 var(--font); letter-spacing: .08em; text-transform: uppercase;
    text-decoration: none; border: 1px solid var(--signal); border-radius: 999px; cursor: pointer;
    transition: background-color .2s var(--ease), color .2s var(--ease), border-color .2s var(--ease);
  }
  .btn:hover { background: var(--text); border-color: var(--text); }
  .btn:disabled { opacity: .55; cursor: progress; }
  .btn-ghost { background: transparent; color: var(--text); border-color: var(--line-2); }
  .btn-ghost:hover { background: transparent; border-color: var(--text); }
  .btn-sm { min-height: 38px; padding: 0 18px; font-size: .75rem; }

  /* header */
  .mast { position: fixed; inset: 0 0 auto; z-index: 5; transition: background-color .3s var(--ease), border-color .3s var(--ease); border-bottom: 1px solid transparent; }
  .mast.solid { background: color-mix(in oklab, var(--void) 88%, transparent); border-bottom-color: var(--line); -webkit-backdrop-filter: blur(8px); backdrop-filter: blur(8px); }
  .mast-in { display: flex; align-items: center; gap: var(--s5); min-height: 72px; }
  .brand { display: inline-flex; align-items: center; gap: 12px; font-weight: 500; font-size: .9375rem; letter-spacing: .08em; text-transform: uppercase; text-decoration: none; color: var(--text); }
  .brand :global(svg) { color: #dcef5f; }
  .mast nav { display: flex; gap: 6px; margin-left: auto; }
  .mast nav a { font: 400 .75rem/1 var(--mono); letter-spacing: .06em; text-transform: uppercase; text-decoration: none; color: var(--text-2); background: var(--deck); padding: 9px 14px; border-radius: 999px; transition: color .2s, background-color .2s; }
  .mast nav a:hover { color: var(--void); background: var(--text); }
  @media (max-width: 900px) { .mast nav { display: none; } .mast .btn-sm { margin-left: auto; } }

  /* hero: the vessel in a black room */
  .hero { position: relative; min-height: max(760px, 100svh); display: flex; flex-direction: column; justify-content: flex-end; overflow: hidden; padding-bottom: var(--s8);
    background: radial-gradient(60% 55% at 62% 46%, #17191c 0%, var(--void) 70%); }
  .hero-stage { position: absolute; inset: 0; }
  .hero-model { position: absolute; left: 31%; right: 1%; top: 96px; }
  .hero-in { position: relative; display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: var(--s6); align-items: end; width: 100%; }
  .hero-copy { grid-column: 1; }
  h1 { margin-top: var(--s4); font-size: clamp(2.25rem, 4.2vw, 4.25rem); line-height: .98; letter-spacing: -0.035em; max-width: 16ch; }
  .nw { white-space: nowrap; }
  .dek { margin-top: var(--s5); color: var(--text-2); max-width: 42ch; font-size: 1.0625rem; }
  .hero-act { display: flex; flex-wrap: wrap; gap: var(--s3); margin-top: var(--s6); }
  .stats { grid-column: 2; margin: 0; display: grid; grid-template-columns: repeat(3, auto); justify-content: end; gap: var(--s8); }
  .stats div { display: flex; flex-direction: column-reverse; gap: var(--s2); }
  .stats dt, .figs dt { font: 400 .75rem/1.3 var(--mono); letter-spacing: .06em; text-transform: uppercase; color: var(--text-2); }
  .stats dd, .figs dd { margin: 0; font-size: clamp(2.5rem, 4.5vw, 4.5rem); line-height: .9; letter-spacing: -0.04em; font-weight: 500; }
  .stats small, .figs small { font-size: .42em; letter-spacing: -0.01em; color: var(--text-2); }
  .stats .key dd, .figs .key dd { color: var(--signal); }
  .stats .key small, .figs .key small { color: var(--signal); }
  @media (max-width: 1100px) {
    .hero-model { left: 12%; }
    .hero-in { grid-template-columns: 1fr; }
    .stats { grid-column: 1; justify-content: start; gap: var(--s7); }
  }
  @media (max-width: 760px) {
    .hero { min-height: 0; padding-top: 88px; padding-bottom: var(--s7); }
    .hero-stage { position: relative; inset: auto; height: 62vw; min-height: 240px; }
    .hero-model { left: 0; right: 0; top: 0; }

    .hero-in { grid-template-columns: 1fr; gap: var(--s7); }
    .stats { grid-column: 1; grid-template-columns: repeat(3, auto); gap: var(--s5); justify-content: start; }
    .stats dd { font-size: 2.25rem; }
    .hero-act .btn { flex: 1 1 auto; }
  }
  @media (max-width: 760px) { .hero :global(.spots) { display: none; } }

  /* section heads */
  .sec-head { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: var(--s4) var(--s6); align-items: end; margin-bottom: var(--s8); }
  .sec-head .kick { grid-column: 1 / -1; }
  h2 { font-size: clamp(2rem, 3.6vw, 3.25rem); line-height: 1; letter-spacing: -0.03em; }
  .indent { display: inline-block; padding-left: 1.2em; }
  .indent-2 { display: inline-block; padding-left: 2.4em; }
  .sec-copy { color: var(--text-2); max-width: 52ch; }
  @media (max-width: 860px) { .sec-head { grid-template-columns: 1fr; margin-bottom: var(--s7); } }

  /* missions: one hull, the package changes */
  .missions { padding-block: var(--s9); border-top: 1px solid var(--line); }
  .stage { display: grid; grid-template-columns: minmax(0, 3fr) minmax(0, 7fr) minmax(0, 3fr); gap: var(--s6); align-items: center; }
  .picker { display: grid; gap: var(--s5); align-self: start; }
  .picker fieldset { margin: 0; padding: 0; border: 0; min-width: 0; }
  .stage > * { min-width: 0; }
  .picker legend { padding: 0 0 var(--s3); }
  .chips { display: flex; flex-wrap: wrap; gap: 6px; }
  .chip {
    display: inline-flex; align-items: center; gap: 8px;
    font: 400 .8125rem/1.2 var(--font); color: var(--text-2); background: var(--deck);
    border: 0; border-radius: 999px; padding: 8px 14px; cursor: pointer; text-align: left;
    transition: background-color .2s var(--ease), color .2s var(--ease);
  }
  .chip:hover { color: var(--text); }
  .chip[aria-checked='true'] { background: var(--text); color: var(--void); }
  .chip[aria-checked='true']::before { content: ''; width: 6px; height: 6px; border-radius: 50%; background: var(--signal); box-shadow: 0 0 0 1px var(--void); }
  .stage-model { position: relative; padding-block: var(--s8); }
  .stage-word { position: absolute; left: 50%; top: 62%; transform: translate(-50%, -50%); margin: 0; font-size: clamp(6rem, 14vw, 14rem); opacity: .55; }
  .stage-model :global(svg) { position: relative; }
  @media (prefers-reduced-motion: no-preference) {
    .stage-word:global(.swap) { animation: swap .6s var(--ease); }
  }
  @keyframes swap { from { opacity: 0; filter: blur(8px); transform: translate(-50%, -44%); } }
  .mission-entry { align-self: center; }
  .mission-entry h3 { margin-top: var(--s3); font-size: clamp(1.5rem, 2.2vw, 2rem); line-height: 1.05; letter-spacing: -0.025em; }
  .mission-entry .note { margin-top: var(--s4); color: var(--text-2); }
  .mission-entry dl { margin: var(--s5) 0 0; }
  .mission-entry dl div { padding: var(--s3) 0; border-top: 1px solid var(--line); }
  .mission-entry dt { font: 400 .6875rem/1.3 var(--mono); letter-spacing: .06em; text-transform: uppercase; color: var(--text-3); }
  .mission-entry dd { margin: 4px 0 0; font-size: .9375rem; }

  #mission-wire[data-active] :global(.w-pay) { opacity: 0; }
  .stage :global(#mission-wire[data-active='air'] .w-pay[data-m='air']),
  .stage :global(#mission-wire[data-active='ew'] .w-pay[data-m='ew']),
  .stage :global(#mission-wire[data-active='mine'] .w-pay[data-m='mine']),
  .stage :global(#mission-wire[data-active='isr'] .w-pay[data-m='isr']),
  .stage :global(#mission-wire[data-active='patrol'] .w-pay[data-m='patrol']),
  .stage :global(#mission-wire[data-active='sar'] .w-pay[data-m='sar']),
  .stage :global(#mission-wire[data-active='env'] .w-pay[data-m='env']),
  .stage :global(#mission-wire[data-active='survey'] .w-pay[data-m='survey']),
  .stage :global(#mission-wire[data-active='cargo'] .w-pay[data-m='cargo']),
  .stage :global(#mission-wire[data-active='ferry'] .w-pay[data-m='ferry']) { opacity: 1; }

  @media (max-width: 1100px) {
    .stage { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
    .stage-model { grid-column: 1 / -1; grid-row: 1; }
  }
