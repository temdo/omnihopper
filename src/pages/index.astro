---
import '../styles/global.css';
import Profile from '../components/Profile.astro';
import Lines from '../components/Lines.astro';
import { sectors, allMissions } from '../lib/missions';

const first = allMissions.find((m) => m.id === 'isr')!;

const particulars: [string, string, string][] = [
  ['A', 'Length overall', '8,323 mm'],
  ['B', 'Beam', '2,250 mm'],
  ['C', 'Freeboard', '441 mm'],
  ['D', 'Draft', '0.33 m'],
  ['E', 'Moulded depth', '771 mm'],
  ['', 'Empty weight', '700 kg'],
  ['', 'Maximum weight', '1,300 kg'],
  ['', 'Useful load', '600 kg'],
  ['', 'Cruise speed', '35 kn (Beaufort 0)'],
  ['', 'Maximum speed', '60 kn'],
  ['', 'Range', '500 nm'],
  ['', 'Fuel', '1,200 l'],
  ['', 'Propulsion', 'Mercury Marine V6 outboard, 200 bhp / 149 kW, 5,800 rpm max'],
  ['', 'Propeller', 'Mercury Enertia 14¾ × 19 in'],
  ['', 'Towed payload', '6.8 kg, 254 × 366 mm, anchored at the bow'],
];

const record = [
  {
    phase: 'Adaptation',
    lead: 'Rapid retrofitting and structural optimisation of the hull for a specific mission profile.',
    work: [
      ['Sensor integration', 'EO/IR, SIGINT, active and passive sonar arrays'],
      ['Antenna masts', 'Structural modification for high-gain, EW-resilient communications'],
      ['Power management', 'Energy systems for long-endurance autonomous and semi-autonomous operation'],
    ],
  },
  {
    phase: 'Sea trials',
    lead: 'The ocean is the ultimate validator. We move systems from the lab to Sea State 4 and beyond.',
    work: [
      ['Rapid prototyping', 'Raising technology readiness level through iterative on-water testing'],
      ['Stress testing', 'Hull integrity and electronic resilience under extreme maritime conditions'],
      ['UxV deployment', 'Launch and recovery support for unmanned surface and underwater vehicles'],
    ],
  },
  {
    phase: 'Sustainment',
    lead: 'Operational uptime is non-negotiable. Maintenance, repair and overhaul built for specialised fleets.',
    work: [
      ['Predictive maintenance', 'Platform data used to keep the vessel available'],
      ['Remote field support', 'Technical teams that deploy to remote operating areas'],
      ['Lifecycle management', 'From commissioning to decommissioning'],
    ],
  },
];

const standards: [string, string][] = [
  ['Engineering', 'IEEE 12207, ISO 9001'],
  ['Maritime', 'SOLAS, IMO standards and relevant NATO STANAGs for maritime data exchange'],
  ['Cyber-physical security', 'ISO/IEC 27001-aligned handling of data from integrated sensors'],
];

const inquiryTypes = ['Platform specifications', 'Sea trial availability', 'Fleet sustainment & MRO', 'Technical consultation', 'Other'];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>OmniHopper — High-endurance autonomous surface vessel</title>
  <meta name="description" content="OmniHopper is a high-endurance autonomous surface vessel for defence, security and offshore missions: 500 nm range, 600 kg useful load, 60 kn, with adaptation, sea trials and sustainment from one supplier." />
  <meta name="theme-color" content="#0a2a4d" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
</head>
<body>
  <a class="skip" href="#vessel">Skip to content</a>

  <header class="mast">
    <div class="wrap mast-in">
      <a class="mark" href="#vessel" aria-label="OmniHopper, top of page">
        <svg viewBox="0 0 44 16" aria-hidden="true"><path d="M1 4h28c6 0 11 3 14 8H6z" /><path d="M1 12h42" /></svg>
        OmniHopper
      </a>
      <nav aria-label="Sections">
        <a href="#missions">Missions</a>
        <a href="#particulars">Particulars</a>
        <a href="#record">Lifecycle</a>
        <a href="#standards">Standards</a>
      </nav>
      <a class="btn btn-sm" href="#enquiries">Request <span class="long">documentation</span><span class="short">docs</span></a>
    </div>
  </header>

  <main>
    <section class="hero" id="vessel" aria-labelledby="title">
      <div class="wrap hero-in">
        <div class="hero-copy">
          <h1 id="title">OmniHopper</h1>
          <p class="class-line">Autonomous surface vessel · patrol, security and logistics · dual-use</p>
          <p class="dek">High-endurance maritime platform for mission-critical operations. Five hundred nautical miles on one load of fuel, six hundred kilograms of mission payload, and no crew required.</p>
          <div class="hero-act">
            <a class="btn" href="#enquiries">Request technical documentation</a>
            <a class="link" href="#missions">See all ten mission fits</a>
          </div>
        </div>
        <div class="fits inking">
          <figure class="fit">
            <Profile id="fit-air" fit="air" compact label="OmniHopper fitted for air defence: AIM-9X missile on a rail launcher amidships, superstructure aft with EO/IR camera." />
            <figcaption><span>Fit A</span> Air &amp; sea defence. AIM-9X on a deck rail launcher.</figcaption>
          </figure>
          <figure class="fit">
            <Profile id="fit-sar" fit="sar" compact label="OmniHopper fitted for search and rescue: two liferaft canisters amidships and a remote fire monitor on the bow." />
            <figcaption><span>Fit B</span> Rescue &amp; firefighting. Liferafts and a remote fire monitor.</figcaption>
          </figure>
          <figure class="fit">
            <Profile id="fit-cargo" fit="cargo" compact label="OmniHopper fitted for logistics: two cargo containers on deck, 600 kg useful load." />
            <figcaption><span>Fit C</span> Offshore logistics. Containerised cargo up to 600 kg.</figcaption>
          </figure>
        </div>
        <dl class="titleblock" aria-label="Drawing title block">
          <div><dt>Drawing</dt><dd>OmniHopper USV · general arrangement</dd></div>
          <div><dt>Sheet</dt><dd>1 of 4</dd></div>
          <div><dt>Scale</dt><dd>NTS</dd></div>
          <div><dt>Rev</dt><dd>A</dd></div>
        </dl>
      </div>
    </section>

    <section class="entry" id="profile" aria-labelledby="profile-h">
      <div class="wrap">
        <h2 id="profile-h" class="visually-hidden">Profile and principal particulars</h2>
        <figure class="plate">
          <Profile id="hero-profile" fit="none" />
          <figcaption><span>Plate 1</span> Profile and sheer. Superstructure aft, EO/IR camera at the masthead. Stations 0 to 10 at 832 mm; lettered dimensions in millimetres.</figcaption>
        </figure>
        <dl class="brief">
          <div><dt>L.O.A.</dt><dd>8,323 mm</dd></div>
          <div><dt>Beam</dt><dd>2,250 mm</dd></div>
          <div><dt>Draft</dt><dd>0.33 m</dd></div>
          <div><dt>Freeboard</dt><dd>441 mm</dd></div>
          <div><dt>Weight, empty / max</dt><dd>700 / 1,300 kg</dd></div>
          <div><dt>Useful load</dt><dd>600 kg</dd></div>
          <div><dt>Speed, cruise / max</dt><dd>35 / 60 kn</dd></div>
          <div><dt>Range</dt><dd>500 nm</dd></div>
          <div class="wide"><dt>Propulsion</dt><dd>Outboard V6, 200 bhp / 149 kW</dd></div>
          <div class="wide"><dt>Control</dt><dd>Autonomous, UAV-integrated</dd></div>
        </dl>
        <div class="enquiries-line">
          <span>Enquiries</span>
          <p>Specifications, sea-trial availability and mission configurations are released on request.</p>
          <a class="btn" href="#enquiries">Request technical documentation</a>
        </div>
      </div>
    </section>

    <section class="missions" id="missions" aria-labelledby="missions-h">
      <div class="wrap">
        <div class="sec-head">
          <h2 id="missions-h">One hull. Ten mission fits.</h2>
          <p>Choose a mission. The drawing shows where its package sits, and the entry below updates.</p>
        </div>
        <div class="picker" role="radiogroup" aria-label="Mission">
          {sectors.map((s) => (
            <fieldset>
              <legend>{s.name}</legend>
              {s.missions.map((m) => (
                <button type="button" role="radio" aria-checked={m.id === first.id ? 'true' : 'false'} data-mission={m.id}>{m.name}</button>
              ))}
            </fieldset>
          ))}
        </div>
        <div class="mission-plate" data-active={first.id}>
          <Profile id="mission-profile" />
          <p class="schematic"><span>Plate 4</span> Mission arrangement. Schematic: packages are shown for position, not to scale.</p>
        </div>
        <dl class="mission-entry" aria-live="polite">
          <div><dt>Mission</dt><dd data-f="name"><span>{first.name}</span></dd></div>
          <div><dt>Sector</dt><dd data-f="sector"><span>{first.sector}</span></dd></div>
          <div><dt>Package</dt><dd data-f="package"><span>{first.package}</span></dd></div>
          <div><dt>Sensors</dt><dd data-f="sensors"><span>{first.sensors}</span></dd></div>
          <div><dt>Effect</dt><dd data-f="effectors"><span>{first.effectors}</span></dd></div>
          <div class="wide"><dt>Why unmanned</dt><dd data-f="note"><span>{first.note}</span></dd></div>
        </dl>
      </div>
    </section>

    <section class="particulars" id="particulars" aria-labelledby="part-h">
      <div class="wrap">
        <div class="sec-head">
          <h2 id="part-h">Particulars</h2>
          <p>Lines and principal figures. Lettered rows match the dimensions on the drawings.</p>
        </div>
        <div class="part-grid">
          <Lines />
          <div class="specs">
            {[particulars.slice(0, 8), particulars.slice(8)].map((rows, i) => (
              <table class="spec">
                <caption class="visually-hidden">{i === 0 ? 'Dimensions and weights' : 'Performance and propulsion'}</caption>
                <thead><tr><th scope="col">Ref</th><th scope="col">{i === 0 ? 'Dimensions' : 'Performance'}</th><th scope="col">Value</th></tr></thead>
                <tbody>
                  {rows.map(([r, k, v]) => (
                    <tr data-ref={r || undefined}><td class="ref">{r}</td><th scope="row">{k}</th><td>{v}</td></tr>
                  ))}
                </tbody>
              </table>
            ))}
          </div>
        </div>
        <p class="ops">Operates without constant human oversight. Integrates with UAVs and other networked systems. Reinforced hull with maritime-grade protection.</p>
      </div>
    </section>

    <section class="record" id="record" aria-labelledby="rec-h">
      <div class="wrap">
        <div class="sec-head">
          <h2 id="rec-h">Forged at sea. Built for resilience.</h2>
          <p>Modern maritime security needs platforms that survive high-attrition, infrastructure-denied environments. We carry the vessel through its whole service life, so you do not assemble hull, integration, trials and support from separate vendors.</p>
        </div>
        <ol class="log">
          {record.map((r) => (
            <li>
              <h3>{r.phase}</h3>
              <p class="lead">{r.lead}</p>
              <dl>
                {r.work.map(([k, v]) => (<div><dt>{k}</dt><dd>{v}</dd></div>))}
              </dl>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="standards" id="standards" aria-labelledby="std-h">
      <div class="wrap std-in">
        <h2 id="std-h">Standards and interoperability</h2>
        <div>
          <p>Our engineering processes follow international and maritime standards, so the vessel fits into existing defence and industrial architectures.</p>
          <dl>
            {standards.map(([k, v]) => (<div><dt>{k}</dt><dd>{v}</dd></div>))}
          </dl>
        </div>
      </div>
    </section>

    <section class="enquiries" id="enquiries" aria-labelledby="enq-h">
      <div class="wrap enq-in">
        <div>
          <h2 id="enq-h">Request technical documentation</h2>
          <p>Secure your maritime perimeter with field-validated engineering. Tell us the mission and we will send the relevant specifications, configurations and sea-trial availability.</p>
        </div>
        <form class="form" method="post" action="/api/enquiry" novalidate>
          <label><span>Name</span><input name="name" autocomplete="name" required /></label>
          <label><span>Organisation</span><input name="organisation" autocomplete="organization" /></label>
          <label><span>Email</span><input name="email" type="email" autocomplete="email" required /></label>
          <label><span>Inquiry</span>
            <select name="type" required>
              <option value="">Select inquiry type</option>
              {inquiryTypes.map((t) => <option>{t}</option>)}
            </select>
          </label>
          <label class="full"><span>Message</span><textarea name="message" rows="5" required></textarea></label>
          <input type="text" name="company_site" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true" />
          <div class="full actions">
            <button class="btn" type="submit">Submit inquiry</button>
            <p class="status" role="status" aria-live="polite"></p>
          </div>
        </form>
      </div>
    </section>
  </main>

  <footer class="foot">
    <div class="wrap foot-in">
      <span>OmniHopper</span>
      <span>High-endurance maritime platforms</span>
      <span>© 2026</span>
    </div>
  </footer>

  <script>
    const data = JSON.parse(document.getElementById('missions-data')!.textContent!);
    const plate = document.querySelector<HTMLElement>('.mission-plate')!;
    const buttons = [...document.querySelectorAll<HTMLButtonElement>('[data-mission]')];
    const fields = [...document.querySelectorAll<HTMLElement>('.mission-entry [data-f]')];

    function select(id: string, focus = false) {
      const m = data[id];
      plate.dataset.active = id;
      buttons.forEach((b) => {
        const on = b.dataset.mission === id;
        b.setAttribute('aria-checked', String(on));
        b.tabIndex = on ? 0 : -1;
        if (on && focus) b.focus();
      });
      fields.forEach((el) => {
        const v = m[el.dataset.f!];
        const changed = el.textContent !== v;
        const span = document.createElement('span');
        span.textContent = v;
        el.replaceChildren(span);
        el.classList.toggle('lit', changed);
      });
    }
    buttons.forEach((b, i) => {
      b.tabIndex = b.getAttribute('aria-checked') === 'true' ? 0 : -1;
      b.addEventListener('click', () => select(b.dataset.mission!));
      b.addEventListener('keydown', (e) => {
        const d = e.key === 'ArrowRight' || e.key === 'ArrowDown' ? 1 : e.key === 'ArrowLeft' || e.key === 'ArrowUp' ? -1 : 0;
        if (!d) return;
        e.preventDefault();
        select(buttons[(i + d + buttons.length) % buttons.length].dataset.mission!, true);
      });
    });

    const form = document.querySelector<HTMLFormElement>('.form')!;
    const status = form.querySelector<HTMLElement>('.status')!;
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      form.querySelectorAll('[aria-invalid]').forEach((el) => el.removeAttribute('aria-invalid'));
      const bad = [...form.querySelectorAll<HTMLInputElement>('[required]')].filter((el) => !el.checkValidity());
      if (bad.length) {
        bad.forEach((el) => el.setAttribute('aria-invalid', 'true'));
        status.dataset.state = 'error';
        status.textContent = `Please complete: ${bad.map((el) => el.closest('label')!.querySelector('span')!.textContent).join(', ')}.`;
        bad[0].focus();
        return;
      }
      const btn = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
      btn.disabled = true;
      status.dataset.state = 'busy';
      status.textContent = 'Sending…';
      try {
        const res = await fetch(form.action, { method: 'POST', body: new FormData(form) });
        if (!res.ok) throw new Error(String(res.status));
        status.dataset.state = 'ok';
        status.textContent = 'Received. We will reply from our engineering desk within two working days.';
        form.reset();
      } catch {
        status.dataset.state = 'error';
        status.textContent = 'The inquiry did not go through. Check your connection and submit again.';
      } finally {
        btn.disabled = false;
      }
    });
  </script>
  <script type="application/json" id="missions-data" set:html={JSON.stringify(Object.fromEntries(allMissions.map((m) => [m.id, m])))} />
</body>
</html>

<style>
  .skip { position: absolute; left: -999px; top: 8px; background: var(--signal); color: var(--signal-ink); padding: 8px 12px; z-index: 10; }
  .skip:focus { left: 8px; }

  .btn {
    display: inline-flex; align-items: center; gap: var(--s2);
    min-height: 48px; padding: 0 var(--s5);
    background: var(--signal); color: var(--signal-ink);
    font: 700 1rem/1 var(--font); font-variation-settings: 'wdth' 90;
    text-decoration: none; border: 0; border-radius: 0; cursor: pointer;
    transition: background-color .2s var(--ease), color .2s var(--ease);
  }
  .btn:hover { background: var(--ink); color: var(--page); }
  .btn:disabled { opacity: .55; cursor: progress; }
  .btn-sm { min-height: 40px; padding: 0 var(--s4); font-size: .9375rem; }

  /* masthead: a bookcloth band */
  .mast { position: sticky; top: 0; z-index: 5; background: var(--cloth); color: var(--cloth-ink); }
  .mast-in { display: flex; align-items: center; gap: var(--s6); min-height: 64px; }
  .mark { display: inline-flex; align-items: center; gap: 10px; font-weight: 800; font-size: 1.125rem; font-variation-settings: 'wdth' 110; text-decoration: none; letter-spacing: .01em; }
  .mark svg { width: 34px; fill: none; stroke: currentColor; stroke-width: 1.6; }
  .mast nav { display: flex; gap: var(--s5); margin-left: auto; font-weight: 600; font-variation-settings: 'wdth' 90; }
  .mast nav a { text-decoration: none; color: var(--cloth-ink-2); }
  .mast nav a:hover { color: var(--cloth-ink); text-decoration: underline; }
  @media (max-width: 860px) { .mast nav { display: none; } .mast .btn-sm { margin-left: auto; } }
  .btn-sm { gap: .3em; }
  .mast .short { display: none; }
  @media (max-width: 520px) { .mast .long { display: none; } .mast .short { display: inline; } }

  /* the entry */
  .hero { padding-block: var(--s7) var(--s6); border-bottom: 2px solid var(--rule); }
  .hero-in { display: grid; grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.4fr); grid-template-areas: 'copy fits' 'tb fits'; gap: var(--s5) var(--s7); align-items: start; }
  .hero-copy { grid-area: copy; padding-top: var(--s5); }
  .hero .dek { margin-top: var(--s5); justify-self: start; }
  .hero-act { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s4) var(--s5); margin-top: var(--s6); }
  .link { font-weight: 700; font-variation-settings: 'wdth' 90; }
  .fits { grid-area: fits; display: grid; gap: var(--s3); }
  .fit { margin: 0; }
  .fit :global(figcaption) { margin-top: 0; }
  .titleblock { grid-area: tb; align-self: end; margin: 0; display: grid; grid-template-columns: 1fr auto auto; border: 1px solid var(--rule); font-size: .8125rem; font-variation-settings: 'wdth' 85; font-variant-numeric: tabular-nums lining-nums; }
  .titleblock div { padding: 6px 10px; border-left: 1px solid var(--rule); }
  .titleblock div:first-child { border-left: 0; grid-column: 1 / -1; border-bottom: 1px solid var(--rule); }
  .titleblock div:nth-child(2) { border-left: 0; }
  .titleblock dt { color: var(--ink-2); font-size: .6875rem; text-transform: uppercase; letter-spacing: .06em; }
  .titleblock dd { margin: 0; font-weight: 700; }
  @media (max-width: 960px) {
    .hero-in { grid-template-columns: 1fr; grid-template-areas: 'copy' 'fits' 'tb'; }
    .hero-copy { padding-top: 0; }
  }
  .entry { padding-block: var(--s7); border-bottom: 2px solid var(--rule); }
  .entry-head { display: grid; grid-template-columns: auto minmax(0, 1fr); align-items: end; gap: var(--s4) var(--s7); padding-bottom: var(--s4); border-bottom: 2px solid var(--rule); }
  h1 { font-size: clamp(3.25rem, 9vw, 6rem); line-height: .86; font-weight: 850; font-variation-settings: 'wdth' 68; letter-spacing: -0.02em; }
  .class-line { margin-top: var(--s3); font-weight: 600; font-variation-settings: 'wdth' 85; color: var(--ink-2); }
  .dek { font-size: clamp(1.125rem, 1.7vw, 1.4rem); line-height: 1.32; font-weight: 500; max-width: 40ch; justify-self: end; }
  .plate { padding-block: var(--s5) var(--s2); }
  .plate { margin: 0; padding-block: var(--s5) 0; }
  :global(figcaption), .schematic { font-size: .875rem; color: var(--ink-2); margin-top: var(--s2); padding-top: var(--s2); border-top: 1px solid var(--rule); }
  :global(figcaption span), .schematic span { font-weight: 800; color: var(--ink); margin-right: .4em; }
  .brief { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); margin: var(--s4) 0 0; border-top: 2px solid var(--rule); column-gap: var(--s5); font-variant-numeric: tabular-nums lining-nums; }
  .brief div { display: flex; justify-content: space-between; align-items: baseline; gap: var(--s3); padding: 7px 0; border-bottom: 1px solid var(--rule); }
  .brief .wide { grid-column: span 2; }
  .brief dt { font-variation-settings: 'wdth' 85; color: var(--ink-2); font-size: .9375rem; }
  .brief dd { margin: 0; font-weight: 750; font-variation-settings: 'wdth' 85; text-align: right; }
  .enquiries-line { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; align-items: center; gap: var(--s5); padding-top: var(--s4); border-top: 1px solid var(--rule); }
  .enquiries-line span { font-weight: 800; font-variation-settings: 'wdth' 80; }
  .enquiries-line p { color: var(--ink-2); max-width: 60ch; }
  @media (max-width: 860px) {
    .entry-head { grid-template-columns: 1fr; }
    .dek { justify-self: start; }
    .brief { grid-template-columns: 1fr; }
    .brief .wide { grid-column: auto; }
    .enquiries-line { grid-template-columns: 1fr; gap: var(--s3); }
    .enquiries-line .btn { justify-content: center; }
  }

  /* section heads */
  .sec-head { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: var(--s6); align-items: end; padding-bottom: var(--s5); margin-bottom: var(--s6); border-bottom: 2px solid currentColor; }
  h2 { font-size: clamp(2rem, 5vw, 3.75rem); line-height: .95; font-variation-settings: 'wdth' 72; }
  .sec-head p { max-width: 52ch; }
  @media (max-width: 860px) { .sec-head { grid-template-columns: 1fr; gap: var(--s3); } }

  /* missions: a bookcloth field */
  .missions { background: var(--cloth); color: var(--cloth-ink); padding-block: var(--s9) var(--s8); }
  .missions .sec-head p { color: var(--cloth-ink-2); }
  .picker { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--s5); margin-bottom: var(--s6); }
  .picker fieldset { margin: 0; padding: 0; border: 0; display: flex; flex-direction: column; }
  .picker legend { padding: 0 0 var(--s2); font-weight: 800; font-variation-settings: 'wdth' 80; }
  .picker button {
    text-align: left; padding: 10px 0; background: none; color: var(--cloth-ink-2);
    font: 600 1rem/1.25 var(--font); font-variation-settings: 'wdth' 95;
    border: 0; border-top: 1px solid var(--cloth-ink-2); cursor: pointer;
    display: flex; justify-content: space-between; gap: var(--s3);
    transition: color .2s var(--ease), padding .3s var(--ease);
  }
  .picker button::after { content: ''; width: 10px; height: 10px; border: 1px solid currentColor; flex: none; margin-top: 4px; }
  .picker button:hover { color: var(--cloth-ink); }
  .picker button[aria-checked='true'] { color: var(--cloth-ink); padding-left: var(--s3); }
  .picker button[aria-checked='true']::after { background: var(--signal); border-color: var(--signal); }
